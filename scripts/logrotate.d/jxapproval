# scripts/logrotate.d/jxapproval —— 日志滚动（FR-M8-08）。
#
# 部署：复制到 /etc/logrotate.d/jxapproval（属主 root，权限 644）。
# 配套：scripts/jxapproval.service 中已设 StandardOutput/StandardError 追加写至
#       /var/log/jxapproval/{app,err}.log（由 systemd 的 LogsDirectory= 创建并授权）。
#
# ★ 使用 copytruncate 而非 postrotate 发信号：
#   本服务是 Go 进程、日志句柄常开且不响应 HUP，用 copytruncate 原地截断最稳
#   （代价：轮转瞬间可能丢失极少量写入，对审计无影响——审计留痕另存数据库）。

/var/log/jxapproval/*.log {
    daily
    rotate 30
    maxsize 100M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    dateext
    dateformat -%Y%m%d
    su jxapp jxapp
}
