# 采购与费用审批平台（自建侧）· 环境变量清单（仅键名，无值）
# 复制为 .env 并填值；.env 绝不入库、不进版本库（FR-M8-06 / TC-25）。
# 与 docs/04-Architecture.md §6.4 一一对应。

# ---- 飞书自建应用（敏感）----
JX_APP_ID=
JX_APP_SECRET=

# ---- 飞书免登（授权登录）----
# 免登回调地址：必须与飞书开放平台【安全设置】→ 重定向 URL 白名单逐字一致，且不得包含 #
# （官方：redirect_uri 含 # 时 fragment 会被拼到回调末尾，SPA 取不到 code）。
# 未配置时缺省取 JX_CALLBACK_DOMAIN + /auth/feishu/callback。
JX_OAUTH_REDIRECT_URI=

# ---- 数据与监听 ----
JX_DATA_DIR=./data
JX_DB_PATH=
JX_LISTEN_ADDR=127.0.0.1:8080
JX_LOCK_PATH=

# ---- 附件对象存储（B39）----
# 现状：本地落盘（可运行的最小实现）；生产口径为云侧 S3 主存 + RustFS 异地备份（ADR-08）。
# 置空＝不缓存、每次回源拉取（降级可用）。
JX_ATTACH_DIR=/attachments

# ---- 会话与内部运维凭据（敏感）----
JX_SESSION_KEY=
JX_INTERNAL_TOKEN=

# ---- 附件主存 S3 兼容对象存储（ADR-08）----
# 四项齐备才启用；缺任一 = 未启用（退回本地落盘或降级直通）。签名由程序自签 SigV4，无需 SDK。
JX_S3_ENDPOINT=
JX_S3_BUCKET=
JX_S3_REGION=us-east-1
# true＝host/bucket/key（MinIO / RustFS 常用）；false＝bucket.host/key（云 S3）
JX_S3_PATH_STYLE=true
JX_S3_AK=
JX_S3_SK=

# ---- 异地备份 RustFS（与主存组成主备双写：写双写、读优先主存并回退备份）----
JX_RUSTFS_ENDPOINT=
JX_RUSTFS_BUCKET=
JX_RUSTFS_REGION=
JX_RUSTFS_PATH_STYLE=
JX_RUSTFS_AK=
JX_RUSTFS_SK=

# ---- 运行环境与开发模式 ----
# prod / test；test 开启可控时间窗（对账补拉）
JX_ENV=prod
# 仅当 DEV_MODE=true 时才注册 POST /internal/dev/inject-event（无飞书凭据时的端到端验证路径）
DEV_MODE=false

# ---- 对账补拉定时（每日；可配置间隔，单位：小时）----
JX_RECONCILE_INTERVAL_HOURS=24
