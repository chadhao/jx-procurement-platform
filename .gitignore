# ---- Go ----
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/

# ---- 构建产物（内嵌前的前端产物不入库，由 CI/构建脚本生成）----
web/dist/
internal/web/dist/

# ---- 本地数据库与运行时数据（绝不入库）----
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
/data/
/tmp/
/logs/
*.log

# ---- 密钥与配置（绝不入库）----
.env
.env.*
!.env.example
*.pem
*.key
config.local.*
secrets/

# ---- Node / 前端 ----
node_modules/
.pnpm-store/
*.tsbuildinfo

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- 临时 ----
*.bak
*.tmp
~$*

# ---- 一次性补丁 / 临时脚本（不入库）----
_patch_*.py
scripts/_commit*.txt

# ---- 探针运行期产物（脚本自建自用，**不入库**）----
# 备份目录每次跑都全量重建；毒化副本跑完即删。入库只会造成"两份 spec"的漂移源。
scripts/_probe_spec_backup/
scripts/_probe_poisoned_check_spec.py
# N-060 T3 收口：一切探针残目录（backup/tmp）与隔离 worktree 一律不入库
_probe_*_backup/
_probe_*_tmp/
scripts/_probe_*_backup/
scripts/_probe_*_tmp/
.probe_worktree/
# N-060 T3 收口（我方补足）：跑探针会 import check_spec ⇒ 生成 __pycache__（运行期产物）
__pycache__/
*.pyc
